# =============================================================
#  Travel Planner Agent — Environment Variables
#  Copy this file to application.properties and fill in values
# =============================================================

# ── IBM WatsonX.ai (IBM Granite) ─────────────────────────────
# Get from: https://cloud.ibm.com → Manage → API Keys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Get from: https://dataplatform.cloud.ibm.com → Projects → Your Project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── OpenWeatherMap ────────────────────────────────────────────
# Free tier at: https://openweathermap.org/api  (60 calls/min)
WEATHER_API_KEY=your_openweathermap_api_key_here

# =============================================================
# NOTE: If you don't have API keys yet, the app runs in
# Demo Mode with pre-built AI responses. Just start it!
# =============================================================
